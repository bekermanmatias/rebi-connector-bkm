# =============================================================================
# Cooperacion NavaSoft Connector - plantilla de configuracion
# Copiar a .env y completar. NUNCA commitear .env (esta en .gitignore).
# =============================================================================

NODE_ENV=production

# --- API HTTP local del connector ---
PORT=3000
# Interfaz de escucha. 127.0.0.1 = solo local (recomendado). 0.0.0.0 expone en LAN.
API_HOST=127.0.0.1
# Bearer token que protege todos los endpoints salvo GET /health.
# Generar uno largo y aleatorio. Si queda vacio, los endpoints quedan deshabilitados.
CONNECTOR_API_TOKEN=
# CORS cerrado por defecto. Lista de origenes permitidos separados por coma.
# Ejemplo: https://app.midominio.com,https://otro.midominio.com
CORS_ALLOWED_ORIGINS=
# Rate limiting (requests por IP y por ventana).
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# --- SQL Server (REPLICA, acceso READ ONLY) ---
# El connector corre en el mismo Windows Server y se conecta a localhost.
# NO abrir 1433 a Internet.
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=BdRebi
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000
SQL_POOL_MIN=0
SQL_POOL_MAX=5

# --- Identidad del connector ---
CONNECTOR_ID=cooperacion-navasoft
CLIENT_ID=cooperacion-peru

# --- API BKM (destino de la sincronizacion de productos, HTTPS saliente) ---
# URL completa del endpoint que recibe los lotes de productos.
BKM_API_URL=
BKM_API_TOKEN=
BKM_API_TIMEOUT_MS=20000
# Reintentos HTTP por batch (0 = sin reintentos internos).
BKM_RETRY_MAX=2
# Tamano de lote enviado a BKM.
SYNC_BATCH_SIZE=500

# --- Sincronizacion automatica ---
# Por defecto deshabilitada hasta conocer la frecuencia real de actualizacion
# NavaSoft -> BdRebi.
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=5

# --- Logs ---
LOG_LEVEL=info
# Archivo de log (relativo al proyecto). Vacio = solo stdout.
LOG_FILE=./logs/connector.log
# Rotacion por tamano (bytes). Default 10 MB.
LOG_MAX_SIZE_BYTES=10485760
# Cantidad de archivos rotados a conservar.
LOG_MAX_FILES=5

# --- Estado local ---
QUEUE_DB_PATH=./data/connector.sqlite

# =============================================================================
# Legado (pipeline generico de discovery/datasets). No hace falta para el flujo
# real de productos hacia BKM. Conservado para el CLI de relevamiento.
# =============================================================================
# DB_SERVER / DB_PORT / DB_DATABASE / DB_USER / DB_PASSWORD (alias de SQL_*)
# REMOTE_API_BASE_URL=
# REMOTE_API_KEY=
# MAPPING_PATH=./config/mapping.json
