# =============================================================================
# Cooperacion NavaSoft Connector - plantilla de configuracion
# Copiar a .env y completar. NUNCA commitear .env (esta en .gitignore).
# =============================================================================

NODE_ENV=production

# --- SQL Server (REPLICA, acceso READ ONLY) ---
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
SQL_POOL_MIN=0
SQL_POOL_MAX=5

# --- Identidad del connector ---
CONNECTOR_ID=cooperacion-navasoft
CLIENT_ID=cooperacion-peru

# --- API externa (HTTPS saliente) ---
REMOTE_API_BASE_URL=
REMOTE_API_KEY=
# Timeout por request HTTP (ms)
REMOTE_API_TIMEOUT_MS=20000
# Cantidad de registros por batch enviado a la API
REMOTE_BATCH_SIZE=500

# --- Sincronizacion ---
# Debe ser exactamente "true" para habilitar sync/scheduler/heartbeat de datos.
SYNC_ENABLED=false
SYNC_PRODUCTS_SECONDS=300
SYNC_STOCK_SECONDS=30
SYNC_PRICES_SECONDS=60
SYNC_CLIENTS_SECONDS=300
# Ejecutar un full sync inicial la primera vez que arranca el scheduler.
SYNC_FULL_ON_START=false

# --- Heartbeat ---
HEARTBEAT_SECONDS=30

# --- Logs ---
LOG_LEVEL=info
# Archivo de log (relativo al proyecto). Vacio = solo stdout.
LOG_FILE=./logs/connector.log
# Rotacion por tamano (bytes). Default 10 MB.
LOG_MAX_SIZE_BYTES=10485760
# Cantidad de archivos rotados a conservar.
LOG_MAX_FILES=5

# --- Estado local (SQLite) ---
QUEUE_DB_PATH=./data/connector.sqlite

# --- Mapping ---
# Ruta al mapping real (derivado del discovery). Si no existe, usa el example.
MAPPING_PATH=./config/mapping.json

# --- Scheduler ---
# Ejecuta el scheduler + heartbeat en el proceso principal.
RUN_SCHEDULER=true
